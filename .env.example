OPENROUTER_API_KEY=sk-or-v1-xxxx
# Jev, TypeSafe's System One model, as a MAGI unit (console.typesafe.ai)
TYPESAFE_API_KEY=

# Clef on Workers AI, for a possible Clef backend (PLAN, State); gehirn does not read these yet
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# gehirn reads only its own variables; tools/withenv.py and tools/trials.py --env-file expand ${NAME}.
GEHIRN_KEY=${OPENROUTER_API_KEY}

# The unit's link key for `gehirn hq` and `gehirn field`, the same on both machines (ADR-0003); generate with `openssl rand -hex 32`
UMBILICAL_KEY=

# The pilot's key, which signs every datagram to the plug (PLAN Phase 1 task 5); gehirn and tools/pilot.py both read it
PILOT_KEY=
